PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/gym-tracker
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ── Email / OTP (Brevo HTTP API) ─────────────────────
# Sign up at app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=your_brevo_api_key_here
# Sender email verified in Brevo → Senders & Domains
BREVO_FROM_EMAIL=your_verified_sender@example.com
BREVO_FROM_NAME=FitCycle

# ── Cloudinary (for future profile image uploads) ────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
